  Methylated: "/path/to/references/Builds/Biscuit_pUC19/pUC19.fa"
  CombinedRef: "/path/to/references/Builds/Biscuit_SpikeIn/lambda_pUC19.fa"
  LambdaContig: "NC_001416.1"
  pUC19Contig:  "L09137.2"
