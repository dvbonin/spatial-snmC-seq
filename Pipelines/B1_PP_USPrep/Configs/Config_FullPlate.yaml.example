# Config for FullPlate.smk -- plates barcoded as one full 384-well set.

InDir: "/path/to/input/data/SNMC_B1/PrepUS"
InFiles:
  FirstPrep: [3, 4]

ConfigDir: "/path/to/this/repository/Pipelines/B1_PP_USPrep/Configs"
WorkingDir: "/path/to/this/repository"
OutDir: "/path/to/output/SNMC_B1/PP_USPrep_All"

Assembly: "MainRef"
RefIndex:
