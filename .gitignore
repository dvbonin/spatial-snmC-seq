# Snakemake cache and metadata
.snakemake/
*.snakemake

# Conda environments
*.yaml.lock
*.conda

# Logs and intermediate outputs
*.log
*.out
*.err

# Raw and reference data
Refs/
*.fastq
*.fq
*.bam
*.bai
*.vcf
*.gz
Envs/Built

# System files
.DS_Store
__pycache__/
*.pyc

# Stuff
Scratch/
