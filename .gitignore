*.docx
*.doc

# Machine-specific configuration (copy from config.sh.example)
config.sh

# Machine-specific pipeline configuration (copy from the .example files)
Pipelines/*/Configs/Config_*.yaml
Pipelines/*/config.yaml
!Pipelines/*/Configs/Config_*.yaml.example
!Pipelines/*/config.yaml.example
